# Copy to .env and fill in real values. Never commit .env.

# Gemini API key (create at https://aistudio.google.com/apikey)
GEMINI_API_KEY=replace_with_your_gemini_api_key

# Shared secret used to authenticate /scan/upload requests.
# The client must send this value in the X-API-Key header.
LEGALMETRIX_API_KEY=replace_with_a_long_random_secret

# Gemini model used for label extraction.
GEMINI_MODEL=gemini-3.8-flash